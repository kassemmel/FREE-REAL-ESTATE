# Copy to .env and fill in. Do NOT commit .env (it holds live secrets).
# Each model route below is optional — leave a section blank to hide it in the UI.

# --- Prisma AIRS (prompt/response scanning for the Ollama + Azure routes) ---
PRISMA_AIRS_API_KEY=
PRISMA_AIRS_PROFILE=
# Region endpoint: service / service-de / service-in / service-sg
PRISMA_AIRS_URL=https://service-de.api.aisecurity.paloaltonetworks.com

# --- Azure AI Foundry / Azure OpenAI ---
# Endpoint: the v1 (OpenAI-compatible) URL works as-is; a classic resource URL
#   (https://<res>.openai.azure.com, no path) also works via the api-version param.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
# Comma-separated deployment names; each appears in the UI as "azure/<name>"
AZURE_OPENAI_DEPLOYMENTS=

# --- Portkey AI gateway (route traffic through the gateway instead of direct) ---
# Hosted gateway, or set to your self-hosted gateway root (must end in /v1).
PORTKEY_BASE_URL=https://aigw.portkey.ai/v1
PORTKEY_API_KEY=
# Provider routing and guardrails come from the config attached to the API key
# in Portkey; PORTKEY_MODELS below only names the model(s) to offer.
# Comma-separated model names; each appears in the UI as "AIGW/<name>".
# Use a bare model name if the API key's config pins the provider, otherwise a
# Model Catalog slug: "@<provider_slug>/<model_slug>".
PORTKEY_MODELS=o4-mini

# --- n8n credentials (used by n8n/n8n-sync.sh import, not by any container) ---
# Values are written into the n8n credentials from n8n/credentials.template.json.
# The OpenAI-type credential for the agent reuses PORTKEY_API_KEY/PORTKEY_BASE_URL.
# Portkey key for the stocks-mcp tool (header x-portkey-api-key)
PORTKEY_MCP_API_KEY=
# AI Red Teaming native n8n target: Webhook Header Auth (header X-AIRT-Key).
# Enter the same value in SCM. Generate with: openssl rand -hex 24.
N8N_AIRT_HEADER_SECRET=
# REST red-teaming target: Chat Trigger Basic Auth. Enter the same values in SCM.
N8N_CHAT_BASIC_USER=
N8N_CHAT_BASIC_PASSWORD=
